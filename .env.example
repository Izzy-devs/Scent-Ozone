# ---- Supabase (Project Settings > API) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server only. Never prefix with NEXT_PUBLIC_ and never commit.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Site ----
# Public URL of the deployed site (used for payment callbacks, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Fallback WhatsApp number (international format, digits only). The admin Settings page overrides this.
NEXT_PUBLIC_WHATSAPP_NUMBER=2340000000000

# ---- Payments (leave blank to stay in clearly labelled test mode: no money is taken, orders stay Unpaid) ----
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=

# ---- Demo presentation ----
# Brand shown across the site, and demo mode (demo strip, labelled sample testimonials, contact placeholders).
# Set NEXT_PUBLIC_DEMO_MODE=false for a real launch.
NEXT_PUBLIC_BRAND_NAME=Scent Ozone
NEXT_PUBLIC_DEMO_MODE=true
